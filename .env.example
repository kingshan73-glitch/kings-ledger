# ─────────────────────────────────────────────────────────────
# 킹스가계부 환경변수
# 이 파일을 복사해서 `.env.local` 을 만들고 값을 채우세요.
#   cp .env.example .env.local        (Windows cmd: copy .env.example .env.local)
# Claude Code 로 "설치해줘" 하면 아래 [필수] 값을 CLI 로 조회해 자동으로 채워 줍니다.
# ─────────────────────────────────────────────────────────────

# [필수] Supabase 연결 정보
# `supabase projects api-keys --project-ref <ref>` 로 조회합니다. (대시보드 복사 불필요)
# URL 은 https://<project-ref>.supabase.co 형식입니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [참고] DB 비밀번호 — 앱 실행에는 쓰이지 않습니다.
# `supabase link` / `supabase db push` 등 CLI 작업에 필요해 기록용으로 보관합니다.
# 초기 설정을 Claude Code 로 진행하면 자동 생성되어 여기에 저장됩니다. (🔒 외부 공유 금지)
SUPABASE_DB_PASSWORD=

# [필수] 로그인 이메일 도메인
# 로그인 ID 뒤에 붙는 가상 이메일 도메인입니다. (예: admin → admin@example.com)
# 그대로 두어도 됩니다.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=example.com

# ─────────────────────────────────────────────────────────────
# 아래는 모두 [선택] 입니다. 비워두면 해당 기능만 동작하지 않을 뿐,
# 앱은 정상적으로 실행됩니다.
#
# 참고: 폰 문자 자동수집(심화)의 토큰은 환경변수가 아니라 앱의
# [설정] ▸ 문자수집 탭에서 발급합니다. 여기에 넣을 값이 없습니다.
# ─────────────────────────────────────────────────────────────

# (선택) 관리자 계정 기본값 바꾸기 — `npm run setup:admin` 이 읽습니다.
# 비워두면 ID admin / 비밀번호 jadong! / 이름 관리자 로 만들어집니다. (비밀번호는 6자 이상)
# 명령 인자(`npm run setup:admin -- 아이디 비밀번호`)가 있으면 그쪽이 우선합니다.
# ADMIN_LOGIN_ID=admin
# ADMIN_NAME=관리자
# ADMIN_PASSWORD=

# (선택) 개발 서버 배너 — 마이페이지에서 비밀번호를 바꾼 뒤 이 값을 채워 두면
# `npm run dev` 시작 배너가 기본 비밀번호(jadong!) 대신 "변경된 비밀번호 사용 중"이라고 표시합니다.
# 값 자체는 화면에 찍히지 않습니다. (🔒 외부 공유 금지)
# E2E_LOGIN_PASSWORD=

# (선택) Cron 엔드포인트 보호 (Vercel 배포 시)
# vercel.json 의 일일 크론(/api/household/inbox/purge-raw — 수집함 문자 원문 30일 정리)이
# `Authorization: Bearer <CRON_SECRET>` 으로 인증합니다. 아무 긴 임의 문자열을 넣고
# Vercel 환경변수에도 같은 값을 등록하세요. 없으면 크론만 401 로 거절되고 앱은 정상 동작합니다.
# CRON_SECRET=

# (선택) 검증 스크립트용 — scripts/verify_*.mjs · test_sms_ingest.mjs 등이 읽습니다. 일반 사용에는 불필요.
# BASE_URL=http://localhost:3000
# LOGIN_ID=admin
# LOGIN_PW=
